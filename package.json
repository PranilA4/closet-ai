{
  "name": "closet-ai",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo": "~56.0.11",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.18",
    "expo-file-system": "~56.0.8",
    "expo-image-picker": "~56.0.17",
    "expo-linear-gradient": "^56.0.4",
    "expo-status-bar": "~56.0.4",
    "express": "^5.2.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "multer": "^2.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "^0.21.2",
    "sharp": "^0.32.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "concurrently -k -n API,EXPO -c green,blue \"npm:server\" \"npm:app\"",
    "preapp": "npm run audit:firestore",
    "app": "expo start",
    "server": "node --watch server/index.mjs",
    "server:watch": "node --watch server/index.mjs",
    "prephone": "npm run audit:firestore",
    "phone": "node scripts/start-phone.mjs",
    "prephone:tunnel": "npm run audit:firestore",
    "phone:tunnel": "node scripts/start-phone.mjs --tunnel",
    "phone:check": "node scripts/start-phone.mjs --check",
    "audit:firestore": "node scripts/audit-firestore-listeners.mjs",
    "preandroid": "npm run audit:firestore",
    "android": "expo start --android",
    "preios": "npm run audit:firestore",
    "ios": "expo start --ios",
    "preweb": "npm run audit:firestore",
    "web": "concurrently -k -n API,WEB -c green,blue \"npm:server\" \"expo start --web\""
  },
  "private": true
}
