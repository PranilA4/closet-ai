# Expo client values from Firebase Project settings > Your apps > Web app.
# These identifiers are safe in the client; Firestore rules protect user data.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Keep localhost for normal web development. `npm run phone` automatically
# overrides this with the computer's current LAN address for Expo Go.
EXPO_PUBLIC_CLOTHING_AI_URL=http://localhost:8787

# Deployment only: point this hostname at the Vultr server before starting Caddy.
API_DOMAIN=api.YOUR_DOMAIN.com

# Server-only Firebase Admin values from a downloaded service-account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n\n-----END PRIVATE KEY-----\n"

# Cloudflare Workers AI free allocation.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Tavily Researcher plan: 1,000 free credits monthly, no card required.
TAVILY_API_KEY=

# Cloudinary Free. All three values remain on the Node server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional legacy value. ClosetAI does not require Gemini.
GEMINI_API_KEY=

PORT=8787
